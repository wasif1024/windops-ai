# This service's identity for mutual TLS (GRP-005).
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{workload}}-tls
  labels:
    app.kubernetes.io/name: {{workload}}
    app.kubernetes.io/part-of: windops
spec:
  secretName: {{workload}}-tls
  commonName: {{workload}}
  dnsNames:
    - {{workload}}
    - {{workload}}.{{namespace}}
    - {{workload}}.{{namespace}}.svc
    - {{workload}}.{{namespace}}.svc.cluster.local
  duration: 720h
  renewBefore: 168h
  privateKey:
    algorithm: ECDSA
    size: 256
    rotationPolicy: Always
  usages:
    - server auth
    - client auth
  issuerRef:
    name: windops-internal
    kind: ClusterIssuer
    group: cert-manager.io
