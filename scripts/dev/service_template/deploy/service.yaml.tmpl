apiVersion: v1
kind: Service
metadata:
  name: {{workload}}
  labels:
    app.kubernetes.io/name: {{workload}}
    app.kubernetes.io/part-of: windops
spec:
  # Headless, so gRPC clients can spread calls across replicas (K8S-004).
  clusterIP: None
  selector:
    app.kubernetes.io/name: {{workload}}
  ports:
    - name: grpc
      port: 50051
      targetPort: grpc
    - name: http
      port: 8080
      targetPort: http
