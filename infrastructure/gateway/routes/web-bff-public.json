{
  "uris": [
    "/api/v1/public/*",
    "/api/v1/openapi.json"
  ],
  "priority": 10,
  "methods": [
    "GET",
    "OPTIONS"
  ],
  "plugins": {
    "opentelemetry": {
      "sampler": {
        "name": "always_on"
      }
    },
    "cors": {
      "allow_origins": "http://localhost:5173",
      "allow_methods": "GET,POST,PUT,PATCH,DELETE,OPTIONS",
      "allow_headers": "Authorization,Content-Type,Idempotency-Key",
      "expose_headers": "RateLimit-Limit,RateLimit-Remaining,RateLimit-Reset,Retry-After,WWW-Authenticate",
      "max_age": 600,
      "allow_credential": false
    },
    "limit-count": {
      "count": 60,
      "time_window": 60,
      "key_type": "var",
      "key": "remote_addr",
      "rejected_code": 429,
      "policy": "local",
      "show_limit_quota_header": true
    }
  },
  "upstream": {
    "type": "roundrobin",
    "scheme": "https",
    "pass_host": "node",
    "tls": {
      "verify": true
    },
    "timeout": {
      "connect": 2,
      "send": 10,
      "read": 15
    },
    "nodes": {
      "windops-web-bff.windops-system.svc.cluster.local:8443": 1
    },
    "checks": {
      "active": {
        "type": "https",
        "https_verify_certificate": true,
        "http_path": "/health/ready",
        "healthy": {
          "interval": 2,
          "successes": 2
        },
        "unhealthy": {
          "interval": 2,
          "http_failures": 2,
          "tcp_failures": 2,
          "timeouts": 2
        }
      }
    }
  }
}
