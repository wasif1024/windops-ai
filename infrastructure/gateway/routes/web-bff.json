{
  "uri": "/api/*",
  "plugins": {
    "opentelemetry": {
      "sampler": {
        "name": "always_on"
      }
    }
  },
  "upstream": {
    "type": "roundrobin",
    "timeout": {
      "connect": 2,
      "send": 10,
      "read": 15
    },
    "nodes": {
      "windops-web-bff.windops-system.svc.cluster.local:8080": 1
    },
    "checks": {
      "active": {
        "type": "http",
        "http_path": "/health/ready",
        "healthy": {
          "interval": 2,
          "successes": 2
        },
        "unhealthy": {
          "interval": 2,
          "http_failures": 2,
          "tcp_failures": 2,
          "timeouts": 2
        }
      }
    }
  }
}
