{
  "uri": "/auth/realms/${WINDOPS_KEYCLOAK_REALM}/login-actions/*",
  "priority": 10,
  "methods": [
    "POST"
  ],
  "plugins": {
    "opentelemetry": {
      "sampler": {
        "name": "always_on"
      }
    },
    "limit-count": {
      "count": 5,
      "time_window": 60,
      "key_type": "var",
      "key": "remote_addr",
      "rejected_code": 429,
      "policy": "local",
      "show_limit_quota_header": true
    }
  },
  "upstream": {
    "type": "roundrobin",
    "scheme": "https",
    "pass_host": "node",
    "tls": {
      "verify": true
    },
    "timeout": {
      "connect": 2,
      "send": 10,
      "read": 15
    },
    "nodes": {
      "windops-keycloak.windops-system.svc.cluster.local:8443": 1
    },
    "checks": {
      "active": {
        "type": "https",
        "https_verify_certificate": true,
        "http_path": "/auth/realms/${WINDOPS_KEYCLOAK_REALM}/.well-known/openid-configuration",
        "healthy": {
          "interval": 5,
          "successes": 2
        },
        "unhealthy": {
          "interval": 5,
          "http_failures": 2,
          "tcp_failures": 2,
          "timeouts": 2
        }
      }
    }
  }
}
