{
  "uid": "windops-llm-operations",
  "title": "LLM Operations",
  "description": "SRS 10.3: tokens, cache hit rate, estimated cost, model latency, provider errors, refusals and retries, for every call to Claude. Rehearsals call no model, so show nothing here.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "windops"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tokens",
      "description": "In the last 24 hours: input, cache reads and writes, and output.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum((increase(windops_llm_tokens_total{provider=\"anthropic\"}[24h]) and windops_llm_tokens_total{provider=\"anthropic\"} offset 24h or windops_llm_tokens_total{provider=\"anthropic\"})))",
          "legendFormat": "tokens"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Estimated cost",
      "description": "In the last 24 hours, from the policy's prices.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "0",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((increase(windops_llm_cost_usd_total{provider=\"anthropic\"}[24h]) and windops_llm_cost_usd_total{provider=\"anthropic\"} offset 24h or windops_llm_cost_usd_total{provider=\"anthropic\"}))",
          "legendFormat": "USD"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit rate",
      "description": "In the last 24 hours: the share of prompt tokens read from the cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((increase(windops_llm_tokens_total{provider=\"anthropic\",kind=\"cache_read\"}[24h]) and windops_llm_tokens_total{provider=\"anthropic\",kind=\"cache_read\"} offset 24h or windops_llm_tokens_total{provider=\"anthropic\",kind=\"cache_read\"})) / sum((increase(windops_llm_tokens_total{provider=\"anthropic\",kind=~\"input|cache_read|cache_write\"}[24h]) and windops_llm_tokens_total{provider=\"anthropic\",kind=~\"input|cache_read|cache_write\"} offset 24h or windops_llm_tokens_total{provider=\"anthropic\",kind=~\"input|cache_read|cache_write\"}))",
          "legendFormat": "hit rate"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Calls",
      "description": "In the last 24 hours: calls Claude answered.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum((increase(windops_llm_calls_total{provider=\"anthropic\"}[24h]) and windops_llm_calls_total{provider=\"anthropic\"} offset 24h or windops_llm_calls_total{provider=\"anthropic\"})))",
          "legendFormat": "calls"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Refusals",
      "description": "In the last 24 hours: answers Claude refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum((increase(windops_llm_calls_total{provider=\"anthropic\",stop_reason=\"refusal\"}[24h]) and windops_llm_calls_total{provider=\"anthropic\",stop_reason=\"refusal\"} offset 24h or windops_llm_calls_total{provider=\"anthropic\",stop_reason=\"refusal\"})))",
          "legendFormat": "refusals"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Provider errors",
      "description": "In the last 24 hours: calls with no answer, other than a run out of budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum((increase(windops_llm_errors_total{provider=\"anthropic\",error!=\"budget_exhausted\"}[24h]) and windops_llm_errors_total{provider=\"anthropic\",error!=\"budget_exhausted\"} offset 24h or windops_llm_errors_total{provider=\"anthropic\",error!=\"budget_exhausted\"})))",
          "legendFormat": "errors"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens, by kind",
      "description": "Every 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(windops_llm_tokens_total{provider=\"anthropic\"}[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Estimated cost, by role",
      "description": "Every hour, in US dollars.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role) (increase(windops_llm_cost_usd_total{provider=\"anthropic\"}[1h]) and windops_llm_cost_usd_total{provider=\"anthropic\"} offset 1h or windops_llm_cost_usd_total{provider=\"anthropic\"})",
          "legendFormat": "{{role}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache hit rate, by role",
      "description": "Over 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role) (rate(windops_llm_tokens_total{provider=\"anthropic\",kind=\"cache_read\"}[15m])) / sum by (role) (rate(windops_llm_tokens_total{provider=\"anthropic\",kind=~\"input|cache_read|cache_write\"}[15m]))",
          "legendFormat": "{{role}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Model latency, by role",
      "description": "Over 15 minutes: time to a whole answer, 50th and 95th percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (role, le) (rate(windops_llm_call_duration_seconds_bucket{provider=\"anthropic\",outcome=\"answered\"}[15m])))",
          "legendFormat": "p50 {{role}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (role, le) (rate(windops_llm_call_duration_seconds_bucket{provider=\"anthropic\",outcome=\"answered\"}[15m])))",
          "legendFormat": "p95 {{role}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Calls, by model and stop reason",
      "description": "Every 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, stop_reason) (increase(windops_llm_calls_total{provider=\"anthropic\"}[5m]))",
          "legendFormat": "{{model}} {{stop_reason}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Provider errors, by kind",
      "description": "Every 5 minutes: rate limited, overloaded, server errors, timeouts, unreachable, rejected, or out of budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error) (increase(windops_llm_errors_total{provider=\"anthropic\"}[5m]))",
          "legendFormat": "{{error}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Refusals and fallbacks",
      "description": "Every 5 minutes: answers refused, and calls served by the fallback model.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role) (increase(windops_llm_calls_total{provider=\"anthropic\",stop_reason=\"refusal\"}[5m]))",
          "legendFormat": "refused {{role}}"
        },
        {
          "refId": "B",
          "expr": "sum by (role) (increase(windops_llm_calls_total{provider=\"anthropic\",fallback=\"true\"}[5m]))",
          "legendFormat": "fallback {{role}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Retries",
      "description": "Every 5 minutes: run attempts that will be tried again. The Anthropic client's own retries of a single request are inside each call's latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workflow) (increase(windops_agent_run_attempt_duration_seconds_count{outcome=\"retried\"}[5m]))",
          "legendFormat": "{{workflow}}"
        }
      ]
    }
  ]
}
