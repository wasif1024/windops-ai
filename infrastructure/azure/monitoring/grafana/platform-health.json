{
  "uid": "windops-platform-health",
  "title": "Platform Health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "windops"
  ],
  "panels": [
    {
      "id": 9,
      "type": "table",
      "title": "Pod health",
      "description": "Running pods only. Last stop reason is empty until a container has stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (kube_pod_status_ready{namespace=~\"windops-.*\", condition=\"true\"} and on (namespace, pod) (kube_pod_status_phase{namespace=~\"windops-.*\", phase=\"Running\"} == 1))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum by (namespace, pod) (kube_pod_container_status_restarts_total{namespace=~\"windops-.*\"} and on (namespace, pod) (kube_pod_status_phase{namespace=~\"windops-.*\", phase=\"Running\"} == 1))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"windops-.*\", container=\"\"} and on (namespace, pod) (kube_pod_status_phase{namespace=~\"windops-.*\", phase=\"Running\"} == 1))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "count by (namespace, pod, reason) (kube_pod_container_status_last_terminated_reason{namespace=~\"windops-.*\"} == 1)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #D": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "reason": 5
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "Value #A": "Status",
              "Value #B": "Restarts",
              "Value #C": "Memory",
              "reason": "Last stop reason"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Status",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "NOT READY",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Ready",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Restarts"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Namespace"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pod"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 470
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"windops-.*\", container=\"\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory by pod",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"windops-.*\", container=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pod restarts in the last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) ((increase(kube_pod_container_status_restarts_total{namespace=~\"windops-.*\"}[1h]) and kube_pod_container_status_restarts_total{namespace=~\"windops-.*\"} offset 1h or kube_pod_container_status_restarts_total{namespace=~\"windops-.*\"}))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pods not ready",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (kube_pod_status_ready{namespace=~\"windops-.*\", condition=\"false\"} and on (namespace, pod) (kube_pod_status_phase{namespace=~\"windops-.*\", phase=\"Running\"} == 1))",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Scrape targets down",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (workload) (up == 0)",
          "legendFormat": "{{workload}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Database, Redis, Qdrant and JetStream replicas ready",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (statefulset) (kube_statefulset_status_replicas_ready{namespace=\"windops-data\"}) or label_replace(sum by (deployment) (kube_deployment_status_replicas_available{namespace=\"windops-data\"}), \"statefulset\", \"$1\", \"deployment\", \"(.+)\")",
          "legendFormat": "{{statefulset}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Data store memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"windops-data\", container=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Data store restarts in the last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) ((increase(kube_pod_container_status_restarts_total{namespace=\"windops-data\"}[1h]) and kube_pod_container_status_restarts_total{namespace=\"windops-data\"} offset 1h or kube_pod_container_status_restarts_total{namespace=\"windops-data\"}))",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
