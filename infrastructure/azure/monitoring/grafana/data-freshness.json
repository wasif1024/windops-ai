{
  "uid": "windops-data-freshness",
  "title": "Data Freshness",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "windops"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Turbines live",
      "description": "Turbines whose newest sample is at most a minute old.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (tenant_id) (windops_telemetry_turbines{state=\"live\"}))",
          "legendFormat": "live"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Turbines delayed",
      "description": "Newest sample from one to five minutes old.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (tenant_id) (windops_telemetry_turbines{state=\"delayed\"}))",
          "legendFormat": "delayed"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Turbines stale",
      "description": "Newest sample over five minutes old. WindopsTelemetryStale fires after two more minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (tenant_id) (windops_telemetry_turbines{state=\"stale\"}))",
          "legendFormat": "stale"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Turbines silent",
      "description": "A device credential, but no sample for a day.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (tenant_id) (windops_telemetry_turbines{state=\"silent\"}))",
          "legendFormat": "silent"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Telemetry delay",
      "description": "From measurement to storage, for each accepted sample, over 5 minutes. WindopsTelemetryDelayed fires when the 95th percentile stays over 30 s for 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(windops_telemetry_ingest_delay_seconds_bucket{kind=\"samples\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(windops_telemetry_ingest_delay_seconds_bucket{kind=\"samples\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(windops_telemetry_ingest_delay_seconds_bucket{kind=\"samples\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Age of each turbine's newest sample",
      "description": "Now. Green up to a minute, orange to five minutes, then red, as the console shows them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 600,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tenant_id, turbine_id) (windops_telemetry_sample_age_seconds)",
          "legendFormat": "{{turbine_id}}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Telemetry delay by tenant, p95",
      "description": "The same delay, for each tenant's devices.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (tenant_id, le) (rate(windops_telemetry_ingest_delay_seconds_bucket{kind=\"samples\"}[5m])))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Age of each turbine's newest sample, over time",
      "description": "A turbine that stops sending climbs steadily from here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tenant_id, turbine_id) (windops_telemetry_sample_age_seconds)",
          "legendFormat": "{{turbine_id}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Samples stored, by tenant",
      "description": "SCADA samples a second, at 1 Hz a turbine.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant_id) (rate(windops_telemetry_ingest_samples_total{kind=\"samples\",outcome=\"accepted\"}[5m]))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Samples refused, by reason",
      "description": "Every 5 minutes, and a reason seen for the first time from its first sample. Each refused sample is kept with its reason (FR-TEL-003). WindopsTelemetryRejected fires over 50 in 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(windops_telemetry_ingest_samples_total{outcome=\"rejected\"}[5m]) and windops_telemetry_ingest_samples_total{outcome=\"rejected\"} offset 5m or windops_telemetry_ingest_samples_total{outcome=\"rejected\"})",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "text",
      "title": "Weather age, document freshness and provider status",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 3
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Weather age arrives with the Weather Service in M6.3, document freshness with knowledge ingestion in Phase 7, and provider status with the agents in Phases 7 and 8 (SRS 10.3)."
      }
    }
  ]
}
