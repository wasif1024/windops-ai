{
  "uid": "windops-microservice-health",
  "title": "Microservice Health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "windops"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workload) (rate(windops_rpc_server_duration_seconds_count[5m]))",
          "legendFormat": "{{workload}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency, 95th percentile",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (workload, le) (rate(windops_rpc_server_duration_seconds_bucket[5m])))",
          "legendFormat": "{{workload}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency, 50th percentile",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (workload, le) (rate(windops_rpc_server_duration_seconds_bucket[5m])))",
          "legendFormat": "{{workload}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency, 99th percentile",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (workload, le) (rate(windops_rpc_server_duration_seconds_bucket[5m])))",
          "legendFormat": "{{workload}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "gRPC failures by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workload, rpc_status) (rate(windops_rpc_server_duration_seconds_count{rpc_status!=\"OK\"}[5m]))",
          "legendFormat": "{{workload}} {{rpc_status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuit breaker state: 0 closed, 1 half-open, 2 open",
      "datasource": {
        "type": "prometheus",
        "uid": "${AZURE_PROMETHEUS_DATASOURCE_UID}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (workload, dependency) (windops_circuit_breaker_state)",
          "legendFormat": "{{workload}} to {{dependency}}"
        }
      ]
    }
  ]
}
