# External provider keys for local development.
#
# Copy this file to .env and add your keys there. Git ignores .env, so it is never committed.
# Never put a real key in this file. Each key is needed only from the module shown.

# Embeddings for knowledge retrieval (M7.2).
OPENAI_API_KEY=

# Web research (M7.4).
TAVILY_API_KEY=

# Claude, for the agent workflow (M8.3).
ANTHROPIC_API_KEY=

# Agent traces and evaluations (M8.9).
LANGSMITH_API_KEY=
