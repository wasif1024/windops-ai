# WindOps settings and provider keys for local development.
#
# Copy this file to .env, or let `make dev` do it, and change values there. Git ignores .env, so
# it is never committed, and images never receive it. In a cloud, set the same names in the
# pipeline's variables and Key Vault instead. scripts/settings.py reads them, in this order: the
# process environment, then .env, then the defaults here.
#
# `make config` puts the WINDOPS_ settings below into the cluster's windops-settings ConfigMap,
# and restarts what reads them. Never put a secret in a WINDOPS_ setting: a ConfigMap is not secret.

# --- Where people reach WindOps -------------------------------------------------------------

# The gateway's public address. The browser, Keycloak's pages and every token's issuer use it.
WINDOPS_PUBLIC_URL=https://localhost:9443
# Other browser origins allowed to call the API and sign in, comma separated: the dev server.
WINDOPS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WINDOPS_KEYCLOAK_REALM=windops
# The audience every user token must carry for the API, and the browser's Keycloak client.
WINDOPS_OIDC_AUDIENCE=windops-api
WINDOPS_WEB_CLIENT_ID=windops-web

# --- The release -------------------------------------------------------------------------------

WINDOPS_ENVIRONMENT=local
WINDOPS_VERSION=local
# DEBUG, INFO, WARNING or ERROR.
WINDOPS_LOG_LEVEL=INFO

# --- Inside the cluster ---------------------------------------------------------------------

WINDOPS_OTLP_ENDPOINT=http://windops-otel-collector.windops-observability.svc.cluster.local:4318
WINDOPS_KEYCLOAK_INTERNAL_URL=https://windops-keycloak.windops-system.svc.cluster.local:8443/auth
WINDOPS_AUTHORIZATION_ADDRESS=windops-authorization.windops-system.svc.cluster.local:50051
WINDOPS_IDENTITY_ADDRESS=windops-identity.windops-system.svc.cluster.local:50051
WINDOPS_TENANT_ADDRESS=windops-tenant.windops-system.svc.cluster.local:50051
WINDOPS_AUDIT_ADDRESS=windops-audit.windops-application.svc.cluster.local:50051
WINDOPS_ASSET_ADDRESS=windops-asset.windops-application.svc.cluster.local:50051

# --- Telemetry retention (SRS 8.3), in days. Whole partitions are dropped once past it, unless a
# snapshot holds them.
WINDOPS_TELEMETRY_RAW_RETENTION_DAYS=90
WINDOPS_TELEMETRY_SUMMARY_RETENTION_DAYS=730
WINDOPS_TELEMETRY_CMS_FEATURE_RETENTION_DAYS=730
WINDOPS_TELEMETRY_CMS_WAVEFORM_RETENTION_DAYS=90
# A raw CMS window is kept from the first batch in each block of this many hours, or on a trigger.
WINDOPS_TELEMETRY_CMS_RAW_EVERY_HOURS=6
# A sample measured more than this many seconds before it arrived is labelled delayed (FR-TEL-003).
WINDOPS_TELEMETRY_DELAY_SECONDS=20

# --- The simulator's devices (M4.4): where they send, and how
# The gateway's device route, from inside the cluster. HTTPS only, checked against our own CA.
WINDOPS_INGEST_URL=https://windops-gateway.windops-system.svc.cluster.local/ingest/v1/samples
# The same seed gives the same weather and wear on every machine.
WINDOPS_SIMULATOR_SEED=1001
# How often each device sends what it has, in seconds.
WINDOPS_SIMULATOR_BATCH_SECONDS=5
# Link trouble to inject, so data-quality checks have something to find: light or none.
WINDOPS_SIMULATOR_DATA_PROBLEMS=light
# How often each device records a CMS vibration batch, in seconds. 0 turns CMS off.
WINDOPS_SIMULATOR_CMS_SECONDS=600

# --- This machine: make dev and the checks ----------------------------------------------------

# The kubectl context, which is also the Minikube profile.
WINDOPS_KUBE_CONTEXT=windops
WINDOPS_DEV_PORT=5173

# --- Provider keys: never put a real key in this file -------------------------------------------
# Each is needed only from the module shown.

# Embeddings for knowledge retrieval (M7.2).
OPENAI_API_KEY=

# Web research (M7.4).
TAVILY_API_KEY=

# Claude, for the agent workflow (M8.3).
ANTHROPIC_API_KEY=

# Agent traces and evaluations (M8.9).
LANGSMITH_API_KEY=

# --- Azure (Phase 4A, ADR 0006)
# The subscription the deployment scripts use, by Azure's own variable name. Only the scripts read it,
# not the services, so it is not a WINDOPS_ setting and never reaches the cluster. Not a secret, but it
# names your account, so set it in .env, not here. No Azure credential is ever kept: this machine uses
# the Azure CLI's signed-in session (az login), and CI uses GitHub OIDC (ADR 0005).
AZURE_SUBSCRIPTION_ID=
